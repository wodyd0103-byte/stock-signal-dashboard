# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node / Next.js
node_modules/
.next/
frontend/out/
*.tsbuildinfo

# 데모 API는 demo-data/에서 빌드할 때마다 생성된다(scripts/build-demo-api.mjs).
frontend/public/api/

# next-env.d.ts is generated by Next.js and its contents differ depending on
# which command wrote it last: `next dev` points it at .next/dev/types/routes.d.ts,
# `next build` points it at .next/types/routes.d.ts. Tracking it therefore makes
# the working tree dirty every time you switch between the two. The Next.js docs
# say to keep it out of Git; every command that needs it regenerates it.
frontend/next-env.d.ts

# Environment
# `.env`와 `.env.local`만 막으면 `.env.production` 같은 이름이 그대로 커밋된다.
# 전부 막고 예시 파일만 되돌린다.
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Build / cache artifacts
.tmp/
backend/.tmp/
backend/data/cache/
# 일일 리포트 출력. 보유 종목과 평단가가 들어가므로 커밋하지 않는다.
backend/data/digest/

# Playwright
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
# Throwaway specs written to capture a before/after of something. Named so they
# cannot be committed by an absent-minded `git add -A`.
frontend/tests/tmp-*.spec.ts

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json
