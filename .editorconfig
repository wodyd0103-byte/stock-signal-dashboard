# Editor-side counterpart to .gitattributes and .prettierrc.json, so a file is
# already correct when it is saved rather than only when Prettier runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
